generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model attachments {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  owner_type attachments_owner_type
  owner_id   BigInt                 @db.UnsignedBigInt
  file_url   String                 @db.VarChar(1000)
  file_type  String?                @db.VarChar(100)
  file_name  String?                @db.VarChar(255)
  file_size  BigInt?                @db.UnsignedBigInt
  created_at DateTime               @default(now()) @db.DateTime(0)

  @@index([owner_type, owner_id], map: "idx_attachments_owner")
}

model comments {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  post_id           BigInt     @db.UnsignedBigInt
  user_id           BigInt     @db.UnsignedBigInt
  parent_comment_id BigInt?    @db.UnsignedBigInt
  content           String     @db.Text
  created_at        DateTime   @default(now()) @db.DateTime(0)
  updated_at        DateTime   @default(now()) @db.DateTime(0)
  deleted_at        DateTime?  @db.DateTime(0)
  comments          comments?  @relation("commentsTocomments", fields: [parent_comment_id], references: [id], onDelete: Cascade, map: "fk_comments_parent")
  other_comments    comments[] @relation("commentsTocomments")
  posts             posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, map: "fk_comments_post")
  users             users      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_comments_user")

  @@index([parent_comment_id], map: "fk_comments_parent")
  @@index([post_id], map: "idx_comments_post")
  @@index([user_id], map: "idx_comments_user")
}

model conversation_members {
  id              BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id BigInt                    @db.UnsignedBigInt
  user_id         BigInt                    @db.UnsignedBigInt
  role            conversation_members_role @default(member)
  joined_at       DateTime                  @default(now()) @db.DateTime(0)
  left_at         DateTime?                 @db.DateTime(0)
  conversations   conversations             @relation(fields: [conversation_id], references: [id], onDelete: Cascade, map: "fk_conversation_members_conversation")
  users           users                     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_conversation_members_user")

  @@unique([conversation_id, user_id], map: "uq_conversation_member")
  @@index([user_id], map: "idx_conversation_members_user")
}

model call_sessions {
  id                 BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id    BigInt                    @db.UnsignedBigInt
  initiated_by       BigInt                    @db.UnsignedBigInt
  room_name          String                    @unique(map: "uq_call_sessions_room") @db.VarChar(128)
  call_type          call_sessions_type
  status             call_sessions_status      @default(ringing)
  idempotency_key    String                    @db.Char(36)
  created_at         DateTime                  @default(now()) @db.DateTime(0)
  accepted_at        DateTime?                 @db.DateTime(0)
  ended_at           DateTime?                 @db.DateTime(0)
  end_reason         call_sessions_end_reason?
  updated_at         DateTime                  @default(now()) @db.DateTime(0)
  call_participants  call_participants[]
  recording_consents call_recording_consents[]
  recordings         call_recordings[]
  conversations      conversations             @relation(fields: [conversation_id], references: [id], onDelete: Cascade, map: "fk_call_sessions_conversation")
  users              users                     @relation(fields: [initiated_by], references: [id], onDelete: Cascade, map: "fk_call_sessions_initiator")

  @@unique([initiated_by, idempotency_key], map: "uq_call_sessions_idempotency")
  @@index([conversation_id, status, created_at], map: "idx_call_sessions_conversation_state")
  @@index([status, created_at], map: "idx_call_sessions_state_created")
  @@index([initiated_by, created_at], map: "idx_call_sessions_initiator_created")
}

model call_participants {
  id        BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  call_id   BigInt                @db.UnsignedBigInt
  user_id   BigInt                @db.UnsignedBigInt
  role      call_participant_role
  joined_at DateTime?             @db.DateTime(0)
  left_at   DateTime?             @db.DateTime(0)
  calls     call_sessions         @relation(fields: [call_id], references: [id], onDelete: Cascade, map: "fk_call_participants_call")
  users     users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_call_participants_user")

  @@unique([call_id, user_id], map: "uq_call_participant")
  @@unique([call_id, role], map: "uq_call_participant_role")
  @@index([user_id, call_id], map: "idx_call_participants_user_call")
}

model call_recording_consents {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  call_id      BigInt        @db.UnsignedBigInt
  user_id      BigInt        @db.UnsignedBigInt
  consented_at DateTime?     @db.DateTime(0)
  revoked_at   DateTime?     @db.DateTime(0)
  updated_at   DateTime      @default(now()) @db.DateTime(0)
  calls        call_sessions @relation(fields: [call_id], references: [id], onDelete: Cascade, map: "fk_call_recording_consents_call")
  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_call_recording_consents_user")

  @@unique([call_id, user_id], map: "uq_call_recording_consent")
  @@index([user_id, call_id], map: "idx_call_recording_consents_user")
}

model call_recordings {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  call_id              BigInt                 @db.UnsignedBigInt
  egress_id            String?                @unique(map: "uq_call_recordings_egress") @db.VarChar(128)
  object_key           String                 @unique(map: "uq_call_recordings_object_key") @db.VarChar(512)
  status               call_recordings_status @default(starting)
  content_type         String                 @default("video/mp4") @db.VarChar(100)
  file_size            BigInt?                @db.UnsignedBigInt
  duration_ms          BigInt?                @db.UnsignedBigInt
  started_at           DateTime?              @db.DateTime(0)
  completed_at         DateTime?              @db.DateTime(0)
  retention_expires_at DateTime?              @db.DateTime(0)
  deleted_at           DateTime?              @db.DateTime(0)
  last_egress_event_at DateTime?              @db.DateTime(0)
  last_error           String?                @db.VarChar(500)
  created_at           DateTime               @default(now()) @db.DateTime(0)
  updated_at           DateTime               @default(now()) @db.DateTime(0)
  calls                call_sessions          @relation(fields: [call_id], references: [id], onDelete: Cascade, map: "fk_call_recordings_call")

  @@index([call_id, created_at], map: "idx_call_recordings_call_created")
  @@index([status, retention_expires_at], map: "idx_call_recordings_retention")
}

model livekit_webhook_events {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  webhook_id        String    @unique(map: "uq_livekit_webhook_id") @db.Char(36)
  event_type        String    @db.VarChar(40)
  egress_id         String?   @db.VarChar(128)
  egress_status     Int?
  event_created_at  DateTime  @db.DateTime(0)
  egress_started_at DateTime? @db.DateTime(0)
  egress_ended_at   DateTime? @db.DateTime(0)
  file_size         BigInt?   @db.UnsignedBigInt
  duration_ms       BigInt?   @db.UnsignedBigInt
  error_code        Int?
  error_message     String?   @db.VarChar(500)
  received_at       DateTime  @default(now()) @db.DateTime(0)
  processed_at      DateTime? @db.DateTime(0)

  @@index([egress_id, processed_at, event_created_at], map: "idx_livekit_webhooks_pending")
}

model conversations {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  type                 conversations_type     @default(direct)
  name                 String?                @db.VarChar(255)
  avatar_url           String?                @db.VarChar(500)
  created_by           BigInt?                @db.UnsignedBigInt
  created_at           DateTime               @default(now()) @db.DateTime(0)
  updated_at           DateTime               @default(now()) @db.DateTime(0)
  direct_user_high_id  BigInt?                @db.UnsignedBigInt
  direct_user_low_id   BigInt?                @db.UnsignedBigInt
  call_sessions        call_sessions[]
  conversation_members conversation_members[]
  users                users?                 @relation(fields: [created_by], references: [id], map: "fk_conversations_creator")
  direct_user_high     users?                 @relation("direct_conversations_high", fields: [direct_user_high_id], references: [id], map: "fk_conversations_direct_high")
  direct_user_low      users?                 @relation("direct_conversations_low", fields: [direct_user_low_id], references: [id], map: "fk_conversations_direct_low")
  messages             messages[]

  @@unique([direct_user_low_id, direct_user_high_id], map: "uq_conversation_direct_pair")
  @@index([created_by], map: "fk_conversations_creator")
  @@index([direct_user_high_id], map: "fk_conversations_direct_high")
}

model friendships {
  id                                    BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  requester_id                          BigInt             @db.UnsignedBigInt
  addressee_id                          BigInt             @db.UnsignedBigInt
  status                                friendships_status @default(pending)
  created_at                            DateTime           @default(now()) @db.DateTime(0)
  updated_at                            DateTime           @default(now()) @db.DateTime(0)
  user_high_id                          BigInt             @db.UnsignedBigInt
  user_low_id                           BigInt             @db.UnsignedBigInt
  users_friendships_addressee_idTousers users              @relation("friendships_addressee_idTousers", fields: [addressee_id], references: [id], onDelete: Cascade, map: "fk_friendships_addressee")
  users_friendships_requester_idTousers users              @relation("friendships_requester_idTousers", fields: [requester_id], references: [id], onDelete: Cascade, map: "fk_friendships_requester")

  @@unique([requester_id, addressee_id], map: "uq_friendship")
  @@unique([user_low_id, user_high_id], map: "uq_friendship_pair")
  @@index([addressee_id], map: "idx_friendships_addressee")
  @@index([requester_id], map: "idx_friendships_requester")
}

model follows {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  follower_id  BigInt   @db.UnsignedBigInt
  following_id BigInt   @db.UnsignedBigInt
  created_at   DateTime @default(now()) @db.DateTime(0)
  follower     users    @relation("follows_follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following    users    @relation("follows_following", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id], map: "uq_follow")
  @@index([following_id], map: "idx_follows_following")
}

model stories {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  owner_id        BigInt            @db.UnsignedBigInt
  media_key       String            @db.VarChar(1000)
  media_type      String            @db.VarChar(100)
  file_name       String            @db.VarChar(255)
  file_size       BigInt            @db.UnsignedBigInt
  caption         String?           @db.VarChar(500)
  visibility      story_visibility  @default(friends)
  created_at      DateTime          @default(now())
  expires_at      DateTime
  deleted_at      DateTime?         @db.DateTime(0)
  users           users             @relation(fields: [owner_id], references: [id], onDelete: Cascade, map: "fk_stories_owner")
  story_reactions story_reactions[]
  story_views     story_views[]

  @@index([owner_id, id], map: "idx_stories_owner_id")
  @@index([expires_at, id], map: "idx_stories_expiration")
  @@index([visibility, expires_at, id], map: "idx_stories_active_visibility")
}

model story_views {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  story_id  BigInt   @db.UnsignedBigInt
  viewer_id BigInt   @db.UnsignedBigInt
  viewed_at DateTime @default(now())
  stories   stories  @relation(fields: [story_id], references: [id], onDelete: Cascade, map: "fk_story_views_story")
  users     users    @relation(fields: [viewer_id], references: [id], onDelete: Cascade, map: "fk_story_views_viewer")

  @@unique([story_id, viewer_id], map: "uq_story_view")
  @@index([viewer_id, viewed_at], map: "idx_story_views_viewer")
}

model story_reactions {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  story_id   BigInt   @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  reaction   String   @db.VarChar(16)
  created_at DateTime @default(now()) @db.DateTime(0)
  stories    stories  @relation(fields: [story_id], references: [id], onDelete: Cascade, map: "fk_story_reactions_story")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_story_reactions_user")

  @@unique([story_id, user_id], map: "uq_story_reaction")
  @@index([story_id, reaction], map: "idx_story_reactions_story")
  @@index([user_id], map: "fk_story_reactions_user")
}

model refresh_tokens {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  revoked_at DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
}

model message_reads {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  message_id BigInt   @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  read_at    DateTime @default(now()) @db.DateTime(0)
  messages   messages @relation(fields: [message_id], references: [id], onDelete: Cascade, map: "fk_message_reads_message")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_message_reads_user")

  @@unique([message_id, user_id], map: "uq_message_read")
  @@index([user_id], map: "fk_message_reads_user")
}

model messages {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id     BigInt                @db.UnsignedBigInt
  sender_id           BigInt?               @db.UnsignedBigInt
  content             String?               @db.Text
  message_type        messages_message_type @default(text)
  reply_to_message_id BigInt?               @db.UnsignedBigInt
  created_at          DateTime              @default(now()) @db.DateTime(0)
  updated_at          DateTime              @default(now()) @db.DateTime(0)
  deleted_at          DateTime?             @db.DateTime(0)
  client_message_id   String?               @db.VarChar(64)
  delivered_at        DateTime?             @db.DateTime(0)
  message_reads       message_reads[]
  conversations       conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade, map: "fk_messages_conversation")
  messages            messages?             @relation("messagesTomessages", fields: [reply_to_message_id], references: [id], map: "fk_messages_reply")
  other_messages      messages[]            @relation("messagesTomessages")
  users               users?                @relation(fields: [sender_id], references: [id], map: "fk_messages_sender")

  @@unique([conversation_id, sender_id, client_message_id], map: "uq_messages_conversation_sender_client_id")
  @@index([reply_to_message_id], map: "fk_messages_reply")
  @@index([conversation_id], map: "idx_messages_conversation")
  @@index([conversation_id, id], map: "idx_messages_conversation_id")
  @@index([created_at], map: "idx_messages_created_at")
  @@index([sender_id], map: "idx_messages_sender")
}

model notifications {
  id                                  BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                             BigInt             @db.UnsignedBigInt
  actor_id                            BigInt?            @db.UnsignedBigInt
  type                                notifications_type
  reference_id                        BigInt?            @db.UnsignedBigInt
  is_read                             Boolean            @default(false)
  created_at                          DateTime           @default(now()) @db.DateTime(0)
  read_at                             DateTime?          @db.DateTime(0)
  users_notifications_actor_idTousers users?             @relation("notifications_actor_idTousers", fields: [actor_id], references: [id], map: "fk_notifications_actor")
  users_notifications_user_idTousers  users              @relation("notifications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([actor_id], map: "fk_notifications_actor")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([is_read, read_at], map: "idx_notifications_read_at")
  @@index([user_id], map: "idx_notifications_user")
}

model posts {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt        @db.UnsignedBigInt
  content        String?       @db.Text
  privacy        posts_privacy @default(public)
  created_at     DateTime      @default(now()) @db.DateTime(0)
  updated_at     DateTime      @default(now()) @db.DateTime(0)
  deleted_at     DateTime?     @db.DateTime(0)
  shared_post_id BigInt?       @db.UnsignedBigInt
  is_repost      Boolean       @default(false)
  comments       comments[]
  original       posts?        @relation("PostReposts", fields: [shared_post_id], references: [id], onUpdate: NoAction, map: "fk_posts_original")
  reposts        posts[]       @relation("PostReposts")
  users          users         @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_posts_user")
  saved_posts    saved_posts[]

  @@index([shared_post_id], map: "idx_posts_original")
  @@index([created_at], map: "idx_posts_created_at")
  @@index([user_id], map: "idx_posts_user")
}

model saved_posts {
  user_id    BigInt   @db.UnsignedBigInt
  post_id    BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.DateTime(0)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_posts_post")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_posts_user")

  @@id([user_id, post_id])
  @@index([post_id], map: "idx_saved_posts_post")
}

model profiles {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @unique(map: "user_id") @db.UnsignedBigInt
  display_name String    @db.VarChar(100)
  avatar_url   String?   @db.VarChar(500)
  bio          String?   @db.Text
  birthday     DateTime? @db.Date
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @default(now()) @db.DateTime(0)
  cover_url    String?   @db.VarChar(500)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_profiles_user")
}

model reactions {
  id            BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                  @db.UnsignedBigInt
  target_type   reactions_target_type
  target_id     BigInt                  @db.UnsignedBigInt
  reaction_type reactions_reaction_type @default(like)
  created_at    DateTime                @default(now()) @db.DateTime(0)
  users         users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_reactions_user")

  @@unique([user_id, target_type, target_id], map: "uq_reaction")
  @@index([target_type, target_id], map: "idx_reactions_target")
}

model two_factor_recovery_codes {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  code_hash  String    @db.VarChar(255)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_recovery_codes_user")

  @@index([user_id], map: "fk_recovery_codes_user")
}

model user_two_factor_auth {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @unique(map: "user_id") @db.UnsignedBigInt
  secret     String    @db.VarChar(255)
  is_enabled Boolean   @default(false)
  enabled_at DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @updatedAt @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_two_factor_user")
}

model users {
  id                                          BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  email                                       String                      @unique(map: "email") @db.VarChar(255)
  user_name                                   String?                     @db.VarChar(100)
  first_name                                  String?                     @db.VarChar(100)
  last_name                                   String?                     @db.VarChar(100)
  avatar                                      String?                     @db.VarChar(500)
  password_hash                               String                      @db.VarChar(255)
  status                                      users_status                @default(active)
  deleted                                     users_deleted               @default(NO)
  deleted_at                                  DateTime?                   @db.DateTime(0)
  created_at                                  DateTime                    @default(now()) @db.DateTime(0)
  updated_at                                  DateTime                    @default(now()) @db.DateTime(0)
  call_participants                           call_participants[]
  call_recording_consents                     call_recording_consents[]
  call_sessions                               call_sessions[]
  comments                                    comments[]
  conversation_members                        conversation_members[]
  conversations                               conversations[]
  direct_conversations_high                   conversations[]             @relation("direct_conversations_high")
  direct_conversations_low                    conversations[]             @relation("direct_conversations_low")
  follows_as_follower                         follows[]                   @relation("follows_follower")
  follows_as_following                        follows[]                   @relation("follows_following")
  friendships_friendships_addressee_idTousers friendships[]               @relation("friendships_addressee_idTousers")
  friendships_friendships_requester_idTousers friendships[]               @relation("friendships_requester_idTousers")
  message_reads                               message_reads[]
  messages                                    messages[]
  notifications_notifications_actor_idTousers notifications[]             @relation("notifications_actor_idTousers")
  notifications_notifications_user_idTousers  notifications[]             @relation("notifications_user_idTousers")
  posts                                       posts[]
  profiles                                    profiles?
  reactions                                   reactions[]
  refresh_tokens                              refresh_tokens[]
  saved_posts                                 saved_posts[]
  stories                                     stories[]
  story_reactions                             story_reactions[]
  story_views                                 story_views[]
  two_factor_recovery_codes                   two_factor_recovery_codes[]
  user_two_factor_auth                        user_two_factor_auth?
}

model system_error_logs {
  id         Int       @id @default(autoincrement())
  logs       String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  deleted    Boolean?  @default(false)
}

enum conversations_type {
  direct
  group
}

enum call_sessions_type {
  audio
  video
}

enum call_sessions_status {
  ringing
  accepted
  declined
  cancelled
  ended
  failed
}

enum call_sessions_end_reason {
  declined
  cancelled
  ended
  failed
  timeout
}

enum call_participant_role {
  caller
  callee
}

enum call_recordings_status {
  starting
  active
  stopping
  stop_failed
  completed
  failed
  deleting
  delete_failed
  deleted
}

enum attachments_owner_type {
  message
  post
  comment
}

enum reactions_target_type {
  post
  comment
  message
}

enum posts_privacy {
  public
  friends
  private
}

enum story_visibility {
  public
  friends
  followers
  private
}

enum notifications_type {
  friend_request
  friend_accept
  message
  post_reaction
  comment
  comment_reaction
  new_post
}

enum conversation_members_role {
  member
  admin
}

