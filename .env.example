# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=8080
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# Example Production: https://your-frontend.vercel.app
# Example Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Alternative alias: CORS_ORIGIN=https://your-frontend.vercel.app

# ==========================================
# DATABASE (MARIADB / MYSQL)
# ==========================================
# DATABASE_URL is used by Prisma CLI (prisma generate / prisma migrate)
DATABASE_URL="mysql://db_user:db_password@db_host:3306/db_name"

# DB_* parameters are used by the runtime MariaDB driver adapter
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nex
DB_PASSWORD=your_db_password
DB_NAME=nex

# ==========================================
# MEDIA STORAGE (S3 / MINIO / R2)
# ==========================================
# S3_ENDPOINT must be a public HTTPS URL accessible by end users in production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nex-images
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_REGION=us-east-1

# ==========================================
# SECURITY & AUTHENTICATION (JWT & 2FA)
# ==========================================
JWT_ACCESS_SECRET=your_jwt_access_secret_hex_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hex_string
JWT_2FA_SECRET=your_jwt_2fa_secret_hex_string

# ==========================================
# REALTIME & CACHE (REDIS)
# ==========================================
# Local: redis://127.0.0.1:6379
# Cloud (Upstash / Redis Cloud): rediss://default:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# ==========================================
# GRAPH DATABASE (NEO4J - OPTIONAL)
# ==========================================
# If not configured, the system falls back to MariaDB for social graph relations
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ==========================================
# AUDIO / VIDEO CALLS (LIVEKIT)
# ==========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional: Call Recording Egress Storage (if recording is enabled)
# RECORDING_S3_ENDPOINT=https://your-s3-endpoint
# RECORDING_S3_BUCKET=nex-recordings
# RECORDING_S3_ACCESS_KEY_ID=your_recording_s3_key
# RECORDING_S3_SECRET_ACCESS_KEY=your_recording_s3_secret
# RECORDING_S3_REGION=us-east-1
# RECORDING_RETENTION_DAYS=30
